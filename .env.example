# Django
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Postgres (Django DB)
POSTGRES_DB=bankval
POSTGRES_USER=bankval
POSTGRES_PASSWORD=bankval
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bankval:bankval@postgres:5432/bankval

# Redis (Celery broker)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_CURATED=curated
MINIO_BUCKET_QUARANTINE=quarantine

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_UPLOADS=bank-uploads

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=bankval
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Upload sizing (bytes)
SMALL_FILE_THRESHOLD=52428800