@"
# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Django
*.log
db.sqlite3
staticfiles/
media/

# Environment
.env
.env.*
!.env.example

# Docker
docker/volumes/

# IDE
.vscode/
.idea/
*.swp

