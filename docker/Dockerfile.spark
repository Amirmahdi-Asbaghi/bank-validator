FROM apache/spark:3.5.1-python3

USER root

# Python deps for our Spark jobs
RUN pip install --no-cache-dir \
    boto3==1.34.120 \
    clickhouse-connect==0.7.16

ENV SPARK_HOME=/opt/spark
ENV SPARK_EXTRA_JARS_DIR=/opt/spark/jars

# Delta Lake + Hadoop-AWS (S3A) jars
# Delta 3.2.0 uses delta-spark (not delta-core)
RUN curl -fsSL --retry 5 --retry-delay 5 \
        -o ${SPARK_EXTRA_JARS_DIR}/delta-spark_2.12-3.2.0.jar \
        https://repo1.maven.org/maven2/io/delta/delta-spark_2.12/3.2.0/delta-spark_2.12-3.2.0.jar && \
    curl -fsSL --retry 5 --retry-delay 5 \
        -o ${SPARK_EXTRA_JARS_DIR}/delta-storage-3.2.0.jar \
        https://repo1.maven.org/maven2/io/delta/delta-storage/3.2.0/delta-storage-3.2.0.jar && \
    curl -fsSL --retry 5 --retry-delay 5 \
        -o ${SPARK_EXTRA_JARS_DIR}/hadoop-aws-3.3.4.jar \
        https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar && \
    curl -fsSL --retry 5 --retry-delay 5 \
        -o ${SPARK_EXTRA_JARS_DIR}/aws-java-sdk-bundle-1.12.262.jar \
        https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar
WORKDIR /opt/spark-jobs